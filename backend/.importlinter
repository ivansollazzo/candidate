# Import rules checked by tests/test_contracts.py (import-linter).
[importlinter]
root_package = app

[importlinter:contract:core]
name = Configuration and messages depend on nothing else
type = forbidden
source_modules =
    app.core
forbidden_modules =
    app.shared
    app.features
    app.main
    app.cli

[importlinter:contract:shared]
name = Shared infrastructure knows no feature
type = forbidden
source_modules =
    app.shared
forbidden_modules =
    app.features
    app.main
    app.cli

[importlinter:contract:features]
name = Features depend only on the layers below them; hooks connect the rest in main.wire()
type = layers
layers =
    app.main | app.cli
    app.features.https | app.features.backups | app.features.updates
    app.features.reports | app.features.users
    app.features.profile | app.features.applications
    app.features.background_jobs
    app.features.auth
    app.features.settings
    app.shared
    app.core
ignore_imports =
    # The settings routes are for admins only
    app.features.settings.router -> app.features.auth.dependencies
